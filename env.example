# GEMINI_API_KEY: Required if Gemini AI API calls are added in the future.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ADMIN_MODERATION_TOKEN: Clave secreta del servidor para aprobar, rechazar o retirar comentarios.
# Nunca incluyas esta clave en el código del navegador ni en variables VITE_*.
ADMIN_MODERATION_TOKEN="CONFIGURAR_TOKEN_SEGURO_EN_SERVIDOR"

# COMMUNITY_DATA_PATH: Ruta opcional del archivo JSON para almacenar reacciones y comentarios en servidor.
# En producción en la nube se recomienda montar un volumen persistente o enlazar una base de datos externa.
COMMUNITY_DATA_PATH="./data/community-store.json"
